{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Communication Endpoint Configuration",
  "description": "Schema for communication endpoints (TCP, UDP, SHM, WebSocket, Storage, Zenoh, MQTT).",
  "type": "object",
  "required": ["protocol"],
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["tcp", "udp", "shm", "websocket", "storage", "zenoh", "rmw_zenoh", "mqtt"],
      "description": "Protocol type."
    },
    "name": {
      "type": "string",
      "description": "Endpoint name.",
      "minLength": 1,
      "maxLength": 256
    },
    "direction": {
      "type": "string",
      "enum": ["in", "out", "inout"],
      "description": "Communication direction."
    },
    "comm_raw_version": {
      "type": "string",
      "enum": ["v1", "v2"],
      "description": "Optional raw packet format version for TCP/UDP/WebSocket."
    },
    "impl_type": {
      "type": "string",
      "enum": ["callback", "poll"],
      "description": "SHM implementation type."
    },
    "asset_name": {
      "type": "string",
      "description": "Target asset name for SHM poll implementation.",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": ["client", "server"],
      "description": "Client or server role (TCP/WebSocket)."
    },
    "local": {
      "type": "object",
      "description": "Local endpoint settings."
    },
    "remote": {
      "type": "object",
      "description": "Remote endpoint settings."
    },
    "name_resolver": {
      "$ref": "#/$defs/name_resolver"
    },
    "expected_clients": {
      "type": "integer",
      "minimum": 1,
      "description": "Expected client count for TCP mux."
    },
    "io": {
      "$ref": "#/$defs/shm_io"
    },
    "options": {
      "type": "object",
      "description": "Socket and protocol options.",
      "properties": {
        "backlog": { "type": "integer", "description": "TCP server listen backlog." },
        "connect_timeout_ms": { "type": "integer", "description": "TCP/WebSocket connect timeout (ms)." },
        "read_timeout_ms": { "type": "integer", "description": "TCP/WebSocket read timeout (ms)." },
        "write_timeout_ms": { "type": "integer", "description": "TCP/WebSocket write timeout (ms)." },
        "blocking": { "type": "boolean", "description": "Blocking mode." },
        "reuse_address": { "type": "boolean", "description": "SO_REUSEADDR option." },
        "keepalive": { "type": "boolean", "description": "TCP keepalive." },
        "no_delay": { "type": "boolean", "description": "TCP_NODELAY (Nagle algorithm)." },
        "recv_buffer_size": { "type": "integer", "description": "Receive buffer size (bytes)." },
        "send_buffer_size": { "type": "integer", "description": "Send buffer size (bytes)." },
        "linger": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "timeout_sec": { "type": "integer" }
          },
          "required": ["enabled"]
        },
        "buffer_size": { "type": "integer", "description": "UDP buffer size (bytes)." },
        "timeout_ms": { "type": "integer", "description": "UDP timeout (ms)." },
        "broadcast": { "type": "boolean", "description": "UDP broadcast permission." },
        "multicast": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "group": { "type": "string", "format": "ipv4" },
            "interface": { "type": "string", "format": "ipv4" },
            "ttl": { "type": "integer" }
          },
          "required": ["enabled"],
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["group"] }
        }
      }
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "zenoh": {
      "$ref": "#/$defs/zenoh"
    },
    "rmw_zenoh": {
      "$ref": "#/$defs/rmw_zenoh"
    },
    "mqtt": {
      "$ref": "#/$defs/mqtt"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "protocol": { "const": "tcp" } } },
      "then": {
        "required": ["direction"],
        "properties": {
          "local": { "$ref": "#/$defs/endpoint" },
          "remote": { "$ref": "#/$defs/endpoint" }
        },
        "anyOf": [
          {
            "required": ["expected_clients", "local"]
          },
          {
            "required": ["role"],
            "anyOf": [
              {
                "if": { "properties": { "direction": { "const": "in" } } },
                "then": { "required": ["local"], "properties": { "role": { "const": "server" } } }
              },
              {
                "if": { "properties": { "direction": { "const": "out" } } },
                "then": { "required": ["remote"], "properties": { "role": { "const": "client" } } }
              },
              {
                "if": { "properties": { "direction": { "const": "inout" } } },
                "then": {
                  "anyOf": [
                    { "if": { "properties": { "role": { "const": "server" } } }, "then": { "required": ["local"] } },
                    { "if": { "properties": { "role": { "const": "client" } } }, "then": { "required": ["remote"] } }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "udp" } } },
      "then": {
        "required": ["direction"],
        "properties": {
          "local": { "$ref": "#/$defs/endpoint" },
          "remote": { "$ref": "#/$defs/endpoint" }
        },
        "anyOf": [
          { "if": { "properties": { "direction": { "const": "in" } } }, "then": { "required": ["local"] } },
          { "if": { "properties": { "direction": { "const": "out" } } }, "then": { "required": ["remote"] } },
          { "if": { "properties": { "direction": { "const": "inout" } } }, "then": { "required": ["local"] } }
        ]
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "websocket" } } },
      "then": {
        "required": ["role", "direction"],
        "properties": {
          "local": { "$ref": "#/$defs/ws_local" },
          "remote": { "$ref": "#/$defs/ws_remote" }
        },
        "anyOf": [
          {
            "if": { "properties": { "direction": { "const": "in" } } },
            "then": { "required": ["local"], "properties": { "role": { "const": "server" } } }
          },
          {
            "if": { "properties": { "direction": { "const": "out" } } },
            "then": { "required": ["remote"], "properties": { "role": { "const": "client" } } }
          },
          {
            "if": { "properties": { "direction": { "const": "inout" } } },
            "then": {
              "required": ["role"],
              "anyOf": [
                { "if": { "properties": { "role": { "const": "server" } } }, "then": { "required": ["local"] } },
                { "if": { "properties": { "role": { "const": "client" } } }, "then": { "required": ["remote"] } }
              ]
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "shm" } } },
      "then": {
        "required": ["io", "impl_type"],
        "properties": {
          "io": { "$ref": "#/$defs/shm_io" }
        },
        "allOf": [
          {
            "if": { "properties": { "impl_type": { "const": "poll" } } },
            "then": { "required": ["asset_name"] }
          }
        ]
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "storage" } } },
      "then": {
        "required": ["direction", "storage"],
        "properties": {
          "storage": { "$ref": "#/$defs/storage" }
        }
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "zenoh" } } },
      "then": {
        "required": ["direction", "zenoh"],
        "properties": {
          "zenoh": { "$ref": "#/$defs/zenoh" }
        }
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "rmw_zenoh" } } },
      "then": {
        "required": ["direction", "rmw_zenoh"],
        "properties": {
          "rmw_zenoh": { "$ref": "#/$defs/rmw_zenoh" }
        }
      }
    },
    {
      "if": { "properties": { "protocol": { "const": "mqtt" } } },
      "then": {
        "required": ["direction", "mqtt"],
        "properties": {
          "mqtt": { "$ref": "#/$defs/mqtt" }
        }
      }
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["address", "port"],
      "properties": {
        "address": {
          "type": "string",
          "description": "IP address or host name."
        },
        "port": {
          "type": "integer",
          "description": "Port number.",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "name_resolver": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "strict": {
          "type": "boolean",
          "description": "If true, unresolved host names are treated as errors."
        }
      }
    },
    "ws_local": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "description": "Listen port number.",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ws_remote": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "description": "Remote host name or IP address.",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "description": "Remote port number.",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "description": "WebSocket path.",
          "minLength": 1,
          "default": "/"
        }
      }
    },
    "shm_io": {
      "type": "object",
      "required": ["robots"],
      "properties": {
        "robots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shm_robot" }
        }
      }
    },
    "shm_robot": {
      "type": "object",
      "required": ["name", "pdu"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pdu": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shm_pdu" }
        }
      }
    },
    "shm_pdu": {
      "type": "object",
      "required": ["name", "notify_on_recv"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "notify_on_recv": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "mode", "path"],
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["file"]
        },
        "mode": {
          "type": "string",
          "enum": ["latest", "queue"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zenoh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path"],
      "description": "Zenoh transport settings. Zenoh-native session and transport details live in the JSON5 file referenced by config_path; Hakoniwa-specific semantics such as key_prefix and per-key notify_on_recv remain here.",
      "properties": {
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a Zenoh JSON5 config file. Relative paths are resolved from the comm config directory."
        },
        "key_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "Prefix used to map PduResolvedKey to Zenoh key expressions: <key_prefix>/<robot>/<channel_id>."
        },
        "io": {
          "$ref": "#/$defs/shm_io",
          "description": "Per-key receive notification settings. The shape matches SHM io so existing PDU declarations can be reused."
        }
      }
    },
    "rmw_zenoh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path", "mappings"],
      "description": "ROS 2 rmw_zenoh-compatible transport metadata. Payload bytes remain opaque; this section maps endpoint keys to rmw_zenoh key expressions and attachments.",
      "properties": {
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a Zenoh JSON5 config file. Relative paths are resolved from the comm config directory."
        },
        "domain_id": {
          "type": "integer",
          "minimum": 0,
          "description": "ROS_DOMAIN_ID-compatible graph/data partition."
        },
        "graph": {
          "$ref": "#/$defs/rmw_zenoh_graph",
          "description": "Optional ROS graph liveliness settings. When enabled, NN liveliness is declared at open and MP/MS topic liveliness is declared at start."
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rmw_zenoh_mapping" }
        }
      }
    },
    "rmw_zenoh_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Declare rmw_zenoh @ros2_lv liveliness tokens for ROS graph visibility."
        },
        "node_name": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudo ROS 2 node name. Invalid ROS node-name characters are sanitized by the runtime."
        },
        "node_namespace": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudo ROS 2 namespace. / is encoded as % in liveliness token key expressions."
        },
        "enclave": {
          "type": "string",
          "minLength": 1,
          "description": "SROS enclave component for graph liveliness. Use % when SROS is not used."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Zenoh session id component. Use auto to let the runtime generate a process-local id when the Zenoh API does not expose one."
        },
        "node_id": {
          "type": "integer",
          "minimum": 0,
          "description": "Pseudo ROS 2 node id component. A single-node endpoint normally uses 0."
        },
        "qos": {
          "type": "string",
          "minLength": 1,
          "description": "rmw_zenoh graph QoS token suffix. The value default is normalized by the runtime to the rmw_zenoh_cpp default QoS keyexpr (::,:,:,:,,). For non-default QoS, provide the suffix observed from rmw_zenoh_cpp."
        }
      }
    },
    "rmw_zenoh_mapping_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Override graph liveliness declaration for this mapping."
        },
        "entity_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Graph entity id. In inout mode this id is used for MP and the following id is used for MS."
        },
        "qos": {
          "type": "string",
          "minLength": 1,
          "description": "Mapping-specific rmw_zenoh graph QoS token suffix. The value default is normalized by the runtime to the rmw_zenoh_cpp default QoS keyexpr."
        }
      }
    },
    "rmw_zenoh_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "ros2"],
      "properties": {
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["robot", "pdu"],
          "description": "Hakoniwa endpoint-side mapping.",
          "properties": {
            "robot": {
              "type": "string",
              "minLength": 1
            },
            "pdu": {
              "type": "string",
              "minLength": 1,
              "description": "PDU org_name from pdudef.json."
            },
            "direction": {
              "type": "string",
              "enum": ["in", "out", "inout"],
              "description": "Per-mapping rmw_zenoh direction. out declares/sends as MP, in declares/subscribes as MS, and inout does both. If omitted, the comm-level direction is used for backward compatibility."
            },
            "notify_on_recv": {
              "type": "boolean",
              "description": "Deprecated for rmw_zenoh recipes. Receive callback notification now follows endpoint.direction; this remains for backward-compatible explicit callback gating."
            }
          }
        },
        "ros2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic", "type_hash"],
          "description": "ROS 2 rmw_zenoh-side mapping.",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "description": "Fully-qualified ROS 2 topic name."
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "description": "Optional rmw_zenoh key-expression type override. Omit or use auto to derive from pdudef type, e.g. geometry_msgs/Twist -> geometry_msgs::msg::dds_::Twist_."
            },
            "type_hash": {
              "type": "string",
              "minLength": 1,
              "description": "ROS 2 type hash managed by hakoniwa-pdu-registry metadata or provided explicitly. Use * only for receive-only wildcard smoke tests."
            },
            "gid": {
              "type": "string",
              "minLength": 1,
              "description": "Optional 32-character hex RMW GID storage override. Omit or use auto for deterministic local generation."
            },
            "graph": {
              "$ref": "#/$defs/rmw_zenoh_mapping_graph",
              "description": "Optional per-mapping ROS graph liveliness override."
            }
          }
        }
      }
    },
    "mqtt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "topic_prefix"],
      "description": "MQTT transport settings. Broker connectivity lives here while PDU keys are mapped onto MQTT topics.",
      "properties": {
        "broker": {
          "type": "string",
          "minLength": 1,
          "description": "Broker URI such as tcp://127.0.0.1:1883."
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "description": "MQTT client id."
        },
        "topic_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "Prefix used to map PduResolvedKey to MQTT topics: <topic_prefix>/<robot>/<channel_id>."
        },
        "qos": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "MQTT QoS level."
        },
        "retain": {
          "type": "boolean",
          "description": "Whether published messages should be retained by the broker."
        }
      }
    }
  }
}
